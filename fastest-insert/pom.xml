<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>dev.professional.blog</groupId>
    <artifactId>fastest-insert</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Fastest Insert — MS SQL Series</name>
    <description>Code examples for the "Fastest Way to Insert Data in MS SQL" blog series on professionaldev.dev</description>

    <modules>
        <module>common</module>
        <module>part1-hibernate-batching</module>
        <module>part2-jdbc-strategies</module>
        <module>part3-multivalue-insert</module>
        <module>part4-bulk-copy-parameter</module>
        <module>benchmarks</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <mssql-jdbc.version>12.8.1.jre11</mssql-jdbc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.professional.blog</groupId>
                <artifactId>fastest-insert-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.professional.blog</groupId>
                <artifactId>fastest-insert-part1-hibernate-batching</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.professional.blog</groupId>
                <artifactId>fastest-insert-part2-jdbc-strategies</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.professional.blog</groupId>
                <artifactId>fastest-insert-part3-multivalue-insert</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.professional.blog</groupId>
                <artifactId>fastest-insert-part4-bulk-copy-parameter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.sqlserver</groupId>
                <artifactId>mssql-jdbc</artifactId>
                <version>${mssql-jdbc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
