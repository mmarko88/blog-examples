<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.professional.blog</groupId>
        <artifactId>fastest-insert</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>fastest-insert-benchmarks</artifactId>
    <name>Fastest Insert — Benchmarks</name>
    <description>Spring Boot app + benchmark tests for all insert strategies</description>

    <dependencies>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-common</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-test-support</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part1-hibernate-batching</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part2-jdbc-strategies</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part3-multivalue-insert</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part4-bulk-copy-parameter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part5-hibernate-tuning</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part6-parallel-inserts</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part7-index-impact</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.professional.blog</groupId>
            <artifactId>fastest-insert-part8-tvp-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>dev.professional.blog.fastinsert.FastestInsertApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
